{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liteagent.local/schemas/core-plugin-contracts.schema.json",
  "title": "LiteAgent core plugin contracts",
  "type": "object",
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_tokens",
        "completion_tokens",
        "total_tokens"
      ],
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "functionCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "arguments"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "string"
        }
      }
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "function"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "function": {
          "$ref": "#/$defs/functionCall"
        }
      }
    },
    "toolFunction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "parameters"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "toolDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "function"
      ],
      "properties": {
        "type": {
          "const": "function"
        },
        "function": {
          "$ref": "#/$defs/toolFunction"
        }
      }
    },
    "chatMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolCall"
          }
        },
        "tool_call_id": {
          "type": "string"
        }
      }
    },
    "llmCompleteInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messages"
      ],
      "properties": {
        "call_id": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/chatMessage"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolDefinition"
          }
        },
        "model": {
          "type": "string"
        },
        "temperature": {
          "type": "number"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "stream": {
          "type": "boolean"
        }
      }
    },
    "llmCompleteOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "finish_reason",
        "usage"
      ],
      "properties": {
        "content": {
          "type": "string"
        },
        "reasoning": {
          "type": "string"
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolCall"
          }
        },
        "finish_reason": {
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        }
      }
    },
    "llmTextChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "delta"
      ],
      "properties": {
        "channel": {
          "enum": [
            "content",
            "reasoning"
          ]
        },
        "delta": {
          "type": "string"
        }
      }
    },
    "llmToolCallChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "index",
        "function"
      ],
      "properties": {
        "channel": {
          "const": "tool_call"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "function": {
          "$ref": "#/$defs/functionCall"
        }
      }
    },
    "streamMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "reasoning": {
          "type": "string"
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolCall"
          }
        },
        "tool_call_id": {
          "type": "string"
        }
      }
    },
    "streamSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "turn_id",
        "step_id",
        "update_id",
        "message",
        "status"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        },
        "step_id": {
          "type": "string"
        },
        "update_id": {
          "type": "integer"
        },
        "message": {
          "$ref": "#/$defs/streamMessage"
        },
        "status": {
          "enum": [
            "streaming",
            "cancel_requested",
            "complete",
            "cancelled",
            "error"
          ]
        }
      }
    },
    "turnInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input"
      ],
      "properties": {
        "input": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        },
        "max_steps": {
          "type": "integer",
          "minimum": 0
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "turnOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "reply",
        "steps",
        "cancelled",
        "usage",
        "seqs"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "reply": {
          "type": "string"
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled": {
          "type": "boolean"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "seqs": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "cancelInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "llmCancelInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id"
      ],
      "properties": {
        "call_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "llmCancelOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "cancelled"
      ],
      "properties": {
        "call_id": {
          "type": "string"
        },
        "cancelled": {
          "type": "boolean"
        }
      }
    },
    "cancelOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "cancelled"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "cancelled": {
          "type": "boolean"
        }
      }
    }
  }
}
