{
  "name": "session",
  "version": "0.5.0",
  "protocol": 6,
  "provides": [
    "session"
  ],
  "consumes": [],
  "entry": "session.exe",
  "autostart": true,
  "description": "File-backed session log plugin (JSONL) with the session Web faces",
  "commands": [
    {
      "name": "dump-trace",
      "description": "Export Session Log facts as JSON (default or -session id)",
      "usage": "/session dump-trace [sessionId]"
    },
    {
      "name": "list",
      "description": "List sessions (id, title, last seq, workspace)",
      "usage": "/session list"
    },
    {
      "name": "derive",
      "description": "Print Model Context projected from Session Log",
      "usage": "/session derive [sessionId]"
    },
    {
      "name": "current",
      "description": "Show Current Session id",
      "usage": "/session current"
    },
    {
      "name": "info",
      "description": "Show Session metadata including Workspace",
      "usage": "/session info [sessionId]"
    }
  ],
  "ui": {
    "entry": "main.js",
    "trust": "full",
    "mounts": [
      {
        "page": "main",
        "slot": "left",
        "component": "session-rail"
      },
      {
        "page": "main",
        "slot": "center",
        "component": "session-workspace"
      },
      {
        "page": "main",
        "slot": "bottom",
        "component": "session-status"
      }
    ]
  },
  "hostFaces": [
    "config",
    "commands"
  ]
}
