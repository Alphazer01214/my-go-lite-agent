{
  "name": "session",
  "version": "0.3.0",
  "protocol": 3,
  "provides": ["session"],
  "consumes": [],
  "entry": "session.exe",
  "description": "File-backed session log plugin (JSONL) with the session Web faces",
  "commands": [
    {
      "name": "dump-trace",
      "description": "Export Session Log facts as JSON (default or -session id)",
      "usage": "/session dump-trace [sessionId]"
    },
    {
      "name": "list",
      "description": "List sessions (id, title, last seq)",
      "usage": "/session list"
    },
    {
      "name": "derive",
      "description": "Print Model Context projected from Session Log",
      "usage": "/session derive [sessionId]"
    },
    {
      "name": "current",
      "description": "Show Current Session id",
      "usage": "/session current"
    }
  ],
  "ui": {
    "entry": "main.js",
    "trust": "full",
    "mounts": [
      { "page": "main", "slot": "sidebar", "component": "session-rail" },
      { "page": "main", "slot": "chat", "component": "session-view" },
      { "page": "main", "slot": "trace", "component": "session-trace" }
    ]
  }
}
