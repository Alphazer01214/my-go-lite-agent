{
  "name": "llm-openai",
  "version": "0.1.0",
  "protocol": 1,
  "entry": "llm-openai",
  "provides": ["llm"],
  "requires": [],
  "depends_on": [],
  "autostart": true,
  "settings": {
    "get": { "capability": "llm", "method": "settings.get" },
    "save": { "capability": "llm", "method": "settings.save" },
    "schema": [
      {
        "key": "models",
        "label": "模型目录",
        "type": "list",
        "required": true,
        "description": "每行一个模型，各自绑定端点、密钥和图像能力。API Key 不回显；留空保持不变。",
        "item_fields": [
          { "key": "id", "label": "模型 ID", "type": "string", "required": true },
          { "key": "label", "label": "显示名", "type": "string" },
          { "key": "context_window", "label": "上下文窗口", "type": "number", "min": 0 },
          {
            "key": "base_url",
            "label": "Base URL",
            "type": "string",
            "required": true,
            "description": "OpenAI-compatible 端点，例如 https://api.deepseek.com/v1。"
          },
          { "key": "api_key", "label": "API Key", "type": "secret" },
          {
            "key": "max_tokens",
            "label": "最大输出 tokens",
            "type": "number",
            "min": 0,
            "description": "0 表示不下发 max_tokens；仅在端点支持该字段时设置。"
          },
          { "key": "vision", "label": "图像输入", "type": "boolean" }
        ]
      },
      {
        "key": "default_model",
        "label": "默认模型",
        "type": "select",
        "required": true,
        "options_from": "models",
        "option_value": "id",
        "option_label": "label",
        "description": "新会话默认使用该模型；已有会话保持创建时的选择。"
      },
      {
        "key": "request_timeout_ms",
        "label": "请求总超时 (ms)",
        "type": "number",
        "description": "单次 LLM 请求的总时限，默认 900000（15 分钟）。"
      },
      {
        "key": "stream_idle_timeout_ms",
        "label": "流空闲超时 (ms)",
        "type": "number",
        "description": "连续多久没有收到 chunk 就中断，默认 120000（2 分钟）。"
      },
      {
        "key": "max_response_bytes",
        "label": "单次响应上限 (bytes)",
        "type": "number",
        "description": "单次流式响应最多读取的字节数，默认 4194304（4 MiB）。"
      }
    ]
  },
  "description": "Stateless OpenAI-compatible LLM completion with streaming",
  "commands": [
    { "name": "config", "description": "Show or set model config", "usage": "/llm-openai config [get|set k=v]" }
  ]
}
