{
  "name": "llm-openai",
  "version": "0.1.0",
  "protocol": 1,
  "entry": "llm-openai",
  "provides": ["llm"],
  "requires": [],
  "depends_on": [],
  "autostart": true,
  "settings": {
    "get": { "capability": "llm", "method": "settings.get" },
    "save": { "capability": "llm", "method": "settings.save" },
    "schema": [
      {
        "key": "base_url",
        "label": "Base URL",
        "type": "string",
        "required": true,
        "description": "OpenAI-compatible 端点，例如 https://api.deepseek.com/v1。"
      },
      {
        "key": "api_key",
        "label": "API Key",
        "type": "secret",
        "description": "留空保持不变；保存后以明文写入插件目录的 config.json。"
      },
      {
        "key": "clear_api_key",
        "label": "清除已保存的 API Key",
        "type": "boolean",
        "description": "保存时清除当前密钥；若同时填写新 Key，以清除为准。"
      },
      {
        "key": "models",
        "label": "模型目录",
        "type": "list",
        "required": true,
        "description": "每行一个模型。上下文窗口用于上下文用量和压缩预算；留空按 0 处理。",
        "item_fields": [
          { "key": "id", "label": "模型 ID", "type": "string", "required": true },
          { "key": "label", "label": "显示名", "type": "string" },
          { "key": "context_window", "label": "上下文窗口", "type": "number", "min": 0 }
        ]
      },
      {
        "key": "default_model",
        "label": "默认模型",
        "type": "select",
        "required": true,
        "options_from": "models",
        "option_value": "id",
        "option_label": "label",
        "description": "新会话默认使用该模型；已有会话保持创建时的选择。"
      }
    ]
  },
  "description": "Stateless OpenAI-compatible LLM completion with streaming",
  "commands": [
    { "name": "config", "description": "Show or set model config", "usage": "/llm-openai config [get|set k=v]" }
  ]
}
