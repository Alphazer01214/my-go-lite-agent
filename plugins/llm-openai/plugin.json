{
  "name": "llm-openai",
  "version": "0.2.0",
  "protocol": 4,
  "autostart": true,
  "provides": [
    "llm"
  ],
  "consumes": [],
  "entry": "llm-openai.exe",
  "timeoutMs": 120000,
  "description": "OpenAI-compatible LLM provider (DeepSeek etc.), streaming",
  "commands": [
    {
      "name": "config",
      "description": "Show or set API key / model / baseURL",
      "usage": "/llm-openai config [get|set key=value]"
    }
  ],
  "ui": {
    "entry": "main.js",
    "trust": "full",
    "mounts": [
      {
        "page": "main",
        "slot": "statusbar",
        "component": "llm-openai-status"
      }
    ]
  },
  "hostFaces": [
    "config",
    "commands"
  ]
}
